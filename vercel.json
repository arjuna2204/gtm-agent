{
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [{ "source": "/", "destination": "/gtm", "permanent": false }],
  "functions": {
    "api/gtm/writeup.js": { "includeFiles": "site/gtm/data/app.json", "maxDuration": 60 }
  },
  "headers": [
    { "source": "/gtm/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ]
}
